{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/narrative_plan.json",
  "title": "NarrativePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "script_plan_id",
    "episode_id",
    "artifact_version",
    "script_type",
    "thesis",
    "thesis_binding",
    "main_objection",
    "nuance",
    "promise",
    "viewer_journey_ref",
    "opening_design_ref",
    "closing_design_ref",
    "climax",
    "blocks",
    "word_budget_total",
    "wpm_target",
    "wpm_provenance",
    "duration_target_minutes",
    "target_language",
    "user_instructions",
    "lineage",
    "input_checksums",
    "schema_version",
    "checksum",
    "created_at"
  ],
  "properties": {
    "script_plan_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "script_type": {
      "type": "string"
    },
    "thesis": {
      "type": "string"
    },
    "thesis_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis_id", "artifact_version", "checksum", "research_id", "evidence_report_id"],
      "properties": {
        "thesis_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "research_id": {"type": "string", "minLength": 1},
        "evidence_report_id": {"type": "string", "minLength": 1}
      }
    },
    "thesis_refined": {
      "type": "string"
    },
    "main_objection": {
      "type": "string"
    },
    "nuance": {
      "type": "string"
    },
    "promise": {
      "type": "string"
    },
    "packaging_hypothesis_ref": {
      "type": "string"
    },
    "viewer_journey_ref": {
      "type": "string"
    },
    "opening_design_ref": {
      "type": "string"
    },
    "closing_design_ref": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id", "function", "central_question", "new_information",
          "emotional_or_intellectual_change", "source_refs", "word_budget",
          "entry_transition", "exit_transition", "must_not_repeat", "prepares_next",
          "viewer_state_before", "viewer_state_after", "partial_payoff", "open_question"
        ],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "function": {"type": "string", "enum": ["ADD", "COMPLICATE", "CONTRAST", "LIMIT", "TRANSFORM", "OPENING", "CLOSING"]},
          "central_question": {"type": "string"},
          "new_information": {"type": "string"},
          "emotional_or_intellectual_change": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "word_budget": {"type": "integer", "minimum": 1},
          "entry_transition": {"type": "string"},
          "exit_transition": {"type": "string"},
          "must_not_repeat": {"type": "string"},
          "prepares_next": {"type": "string"},
          "viewer_state_before": {"type": "string"},
          "viewer_state_after": {"type": "string"},
          "partial_payoff": {"type": "string"},
          "open_question": {"type": "string"}
        }
      }
    },
    "climax": {
      "type": "string"
    },
    "word_budget_total": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "wpm_target": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "wpm_provenance": {
      "enum": ["EPISODE_EXPLICIT", "SUGGESTED_ACCEPTED", null]
    },
    "duration_target_minutes": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "target_language": {
      "type": ["string", "null"]
    },
    "user_instructions": {
      "type": "array",
      "items": {"type": "object"}
    },
    "lineage": {"type": "object"},
    "input_checksums": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "required": ["wpm_target"],
        "properties": {"wpm_target": {"type": "null"}}
      },
      "then": {
        "properties": {
          "wpm_provenance": {"type": "null"},
          "word_budget_total": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "required": ["wpm_target"],
        "properties": {"wpm_target": {"type": "integer"}}
      },
      "then": {
        "properties": {
          "wpm_provenance": {"enum": ["EPISODE_EXPLICIT", "SUGGESTED_ACCEPTED"]},
          "word_budget_total": {"type": "integer", "minimum": 1}
        }
      }
    }
  ]
}
