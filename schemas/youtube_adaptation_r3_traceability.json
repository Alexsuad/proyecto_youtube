{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YouTubeAdaptationR3Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "capabilities"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "producer_component",
          "auditor_component",
          "input_contracts",
          "output_contract",
          "decision_authority",
          "veto_conditions",
          "evidence",
          "invalidated_by",
          "real_execution_required",
          "availability_status"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "producer_component": {
            "type": "string",
            "minLength": 1
          },
          "auditor_component": {
            "type": "string",
            "minLength": 1
          },
          "input_contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_contract": {
            "type": "string",
            "minLength": 1
          },
          "decision_authority": {
            "type": "string",
            "minLength": 1
          },
          "veto_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "invalidated_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "real_execution_required": {
            "type": "boolean"
          },
          "availability_status": {
            "enum": [
              "IMPLEMENTED_NOT_DEMONSTRATED",
              "NON_EXECUTABLE_CURRENT"
            ]
          }
        }
      }
    }
  }
}
