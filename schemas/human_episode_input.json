{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/human_episode_input.json",
  "title": "Human Episode Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "interaction_id",
    "occurred_at",
    "channel",
    "mode",
    "content",
    "context",
    "works",
    "actor_ref",
    "provenance",
    "processing_status"
  ],
  "properties": {
    "contract": {
      "const": "human_episode_input"
    },
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "2.0.0",
        "3.0.0"
      ]
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "TOPIC_FIRST",
        "ANCHOR_WORK_FIRST",
        "CORPUS_FIRST"
      ]
    },
    "content": {
      "type": "string"
    },
    "initial_question": {
      "type": [
        "string",
        "null"
      ]
    },
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "works": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object"
    },
    "processing_status": {
      "enum": [
        "RECEIVED",
        "REGISTERED",
        "READY",
        "CANCELLED"
      ]
    },
    "user_instructions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/user_instruction"
      }
    },
    "duration_target_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "target_language": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "research_role": {
      "type": "string",
      "enum": [
        "ANCLA",
        "NORMAL"
      ]
    },
    "editorial_intent": {
      "type": "string",
      "enum": [
        "NO_DECLARADA",
        "PREFERIDA",
        "REQUERIDA"
      ]
    },
    "work_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_ref", "editorial_intent"],
        "properties": {
          "work_ref": {"type": "string", "minLength": 1},
          "editorial_intent": {"enum": ["NO_DECLARADA", "PREFERIDA", "REQUERIDA"]}
        }
      }
    },
    "selection_authority": {
      "enum": ["NOT_DECLARED", "OWNER_DECIDES", "DELEGATED_TO_RESEARCH"]
    },
    "material_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_ref", "material_kind", "source_ref"],
        "properties": {
          "material_ref": {"type": "string", "minLength": 1},
          "material_kind": {"enum": ["TEXT", "MARKDOWN", "JSON", "TRANSCRIPT", "OTHER"]},
          "source_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"contract_version": {"const": "3.0.0"}}, "required": ["contract_version"]},
      "then": {"required": ["work_intents", "selection_authority", "material_refs"]}
    }
  ],
  "$defs": {
    "user_instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "text"
      ],
      "properties": {
        "category": {
          "enum": [
            "CONTEXT_ONLY",
            "MAY_INCLUDE",
            "MUST_INCLUDE",
            "MUST_INCLUDE_VERBATIM"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
