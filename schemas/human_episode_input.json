{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/human_episode_input.json",
  "title": "Human Episode Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "interaction_id", "occurred_at", "channel", "mode", "content", "context", "works", "actor_ref", "provenance", "processing_status"],
  "properties": {
    "contract": {"const": "human_episode_input"},
    "contract_version": {"const": "1.0.0"},
    "interaction_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "channel": {"type": "string", "minLength": 1},
    "mode": {"enum": ["TOPIC_FIRST", "ANCHOR_WORK_FIRST", "CORPUS_FIRST"]},
    "content": {"type": "string"},
    "initial_question": {"type": ["string", "null"]},
    "context": {"type": ["string", "null"]},
    "works": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actor_ref": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "processing_status": {"enum": ["RECEIVED", "REGISTERED", "READY", "CANCELLED"]}
  }
}
