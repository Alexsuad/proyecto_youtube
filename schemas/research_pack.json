{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/research_pack.json",
  "title": "ResearchPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_id",
    "episode_id",
    "brief_version",
    "scope",
    "facts",
    "interpretations",
    "hypotheses",
    "contradictions",
    "alternative_views",
    "coverage",
    "critical_claims_assessment",
    "narrative_evidence",
    "external_reality_evidence",
    "source_registry",
    "claims_candidates",
    "unsupported_claims",
    "narrative_opportunities",
    "limitations",
    "created_at"
  ],
  "properties": {
    "research_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "brief_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "alternative_views": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/coverageEntry"}
    },
    "critical_claims_assessment": {"$ref": "#/definitions/criticalClaimsAssessment"},
    "narrative_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/narrativeEvidence"
      }
    },
    "external_reality_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/externalEvidence"
      }
    },
    "source_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/sourceRef"
      }
    },
    "claims_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/unsupportedClaim"
      }
    },
    "narrative_opportunities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "research_pack_kind": {
      "type": "string",
      "enum": ["GENERIC", "PHENOMENON"],
      "description": "IR1-001: distingue un ResearchPack de fenómeno del genérico sin duplicar autoridad."
    },
    "phenomenon": {"$ref": "#/definitions/phenomenonScope"},
    "editorial_uses": {"$ref": "#/definitions/editorialUses"},
    "rival_analysis": {
      "type": "array",
      "items": {"$ref": "#/definitions/rivalAnalysis"}
    },
    "semantic_status": {"$ref": "#/definitions/semanticStatus"},
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"research_pack_kind": {"const": "PHENOMENON"}},
        "required": ["research_pack_kind"]
      },
      "then": {
        "required": [
          "phenomenon",
          "editorial_uses",
          "rival_analysis",
          "semantic_status"
        ]
      }
    }
  ],
  "definitions": {
    "coverageEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "status", "related_finding_ids", "related_source_ids", "limitation_or_pending", "scope_decision", "editorial_impact", "propagated_constraint", "mitigation_status"],
      "properties": {
        "dimension_id": {"type": "string", "enum": ["CENTRAL_QUESTION", "CONFLICT", "INITIAL_HYPOTHESIS", "HUMAN_SOCIAL_HISTORICAL_OR_CULTURAL_PHENOMENON", "PRIMARY_NARRATIVE_MATERIAL", "CRITICAL_CLAIMS", "ALTERNATIVE_PERSPECTIVES"]},
        "status": {"type": "string", "enum": ["COVERED", "PARTIALLY_COVERED", "PENDING", "NOT_VERIFIABLE"]},
        "related_finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "related_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "limitation_or_pending": {"type": ["string", "null"]}
        ,"scope_decision": {"type": "string", "enum": ["NONE", "REDUCED_SCOPE", "BLOCKED"]},
        "editorial_impact": {"type": "string", "enum": ["NOT_APPLICABLE", "NON_CRITICAL", "CRITICAL"]},
        "propagated_constraint": {"type": ["string", "null"]},
        "mitigation_status": {"type": "string", "enum": ["NOT_REQUIRED", "MITIGATED", "INSUFFICIENT"]}
      }
    },
    "criticalClaimsAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "claim_ids", "justification", "editorial_impact"],
      "properties": {
        "status": {"type": "string", "enum": ["IDENTIFIED", "NONE_JUSTIFIED"]},
        "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "justification": {"type": ["string", "null"]},
        "editorial_impact": {"type": "string", "enum": ["NONE", "LIMITED", "MATERIAL", "CRITICAL"]}
      }
    },
    "narrativeEvidence": {
      "allOf": [
        {"$ref": "#/definitions/researchItem"},
        {"properties": {"evidence_kind": {"type": "string", "enum": ["SCENE", "SEQUENCE", "DIALOGUE", "PASSAGE", "CHAPTER", "DECISION", "NARRATIVE_EVENT", "FORMAL_ELEMENT"]}}, "required": ["evidence_kind"]}
      ]
    },
    "externalEvidence": {
      "allOf": [
        {"$ref": "#/definitions/researchItem"},
        {"properties": {"evidence_kind": {"type": "string", "enum": ["STUDY", "DOCUMENT", "DATA", "STATEMENT", "HISTORICAL_RECORD", "INSTITUTIONAL_SOURCE", "VERIFIABLE_EVENT", "EXPERT_ANALYSIS"]}}, "required": ["evidence_kind"]}
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "source_type",
        "access_type",
        "locator",
        "confidence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "access_type": {
          "type": "string",
          "enum": [
            "DIRECT",
            "INDIRECT",
            "SECONDARY_ONLY"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "notes": {
          "type": "string"
        },
        "evidence_kind": {
          "type": "string"
        }
      }
    },
    "researchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "statement",
        "source_refs",
        "locator",
        "confidence"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "material_id": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidence_kind": {
          "type": "string"
        }
      }
    },
    "unsupportedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "reason"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "attempted_source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "phenomenonScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phenomenon_id",
        "phenomenon_kind"
      ],
      "properties": {
        "phenomenon_id": {
          "type": "string",
          "minLength": 1
        },
        "phenomenon_kind": {
          "type": "string",
          "enum": [
            "HUMAN",
            "SOCIAL",
            "HISTORICAL",
            "CULTURAL",
            "PSYCHOLOGICAL",
            "NARRATIVE"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "editorialUses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_uses"
      ],
      "properties": {
        "intended_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
            "CENTRAL_CLAIM_SUPPORT",
            "SECONDARY_CONTEXT",
            "SENSITIVE_HANDLING",
              "CONTROVERSIAL_BALANCE",
              "NARRATIVE_MATERIAL",
              "CONTEXTUAL_BACKGROUND"
            ]
          }
        },
        "criticality_map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claims"],
          "properties": {
            "claims": {
              "type": "array",
              "items": {"$ref": "#/definitions/claimCriticality"}
            }
          }
        }
      }
    },
    "claimCriticality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "criticality",
        "intended_use"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "type": "string",
          "enum": [
            "CENTRAL",
            "SECONDARY",
            "SENSITIVE",
            "CONTROVERSIAL"
          ]
        },
        "intended_use": {
          "type": "string",
          "enum": [
            "CENTRAL_CLAIM_SUPPORT",
            "SECONDARY_CONTEXT",
            "SENSITIVE_HANDLING",
            "CONTROVERSIAL_BALANCE",
            "NARRATIVE_MATERIAL",
            "CONTEXTUAL_BACKGROUND"
          ]
        }
      }
    },
    "rivalAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rival_explanation_id",
        "statement",
        "agreement_status",
        "disagreement_kind",
        "claim_ids",
        "source_refs"
      ],
      "properties": {
        "rival_explanation_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "agreement_status": {
          "type": "string",
          "enum": [
            "CONSENSUS",
            "DISAGREEMENT",
            "COUNTEREXAMPLE",
            "UNCERTAINTY"
          ]
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "disagreement_kind": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "CONTROVERSY",
            "LIMITED",
            "RIVAL_OPEN",
            "INVESTIGATION_REQUIRED",
            "BLOCKED"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "semanticStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_per_claim",
        "ir4_dependency"
      ],
      "properties": {
        "status_per_claim": {
          "type": "array",
          "items": {"$ref": "#/definitions/semanticClaimStatus"}
        },
        "ir4_dependency": {
          "type": "string",
          "const": "DEFERRED_TO_R1_M6",
          "description": "IR1-006: la emisión de suficiencia funcional requiere IR4 (R1-M6). Este campo materializa solo la representación semántica."
        }
      }
    },
    "semanticClaimStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "semantic_level",
        "intended_use"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_level": {
          "type": "string",
          "enum": [
            "DEMONSTRATED",
            "PLAUSIBLE",
            "SPECULATIVE"
          ]
        },
        "intended_use": {
          "type": "string",
          "minLength": 1
        },
        "sufficiency_for_intended_use": {
          "type": ["string", "null"],
          "enum": ["NOT_FUNCTIONALLY_VALIDATED", "IR4_REQUIRED", null],
          "description": "IR1-006: representación no funcional; R1-M6 debe extender este enum antes de emitir suficiencia."
        }
      }
    }
  }
}
