{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/research_pack.json",
  "title": "ResearchPack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "research_id",
    "episode_id",
    "brief_version",
    "scope",
    "facts",
    "interpretations",
    "hypotheses",
    "contradictions",
    "alternative_views",
    "coverage",
    "critical_claims_assessment",
    "narrative_evidence",
    "external_reality_evidence",
    "source_registry",
    "claims_candidates",
    "unsupported_claims",
    "narrative_opportunities",
    "limitations",
    "multilingual_research",
    "created_at"
  ],
  "properties": {
    "research_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "brief_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "alternative_views": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/coverageEntry"}
    },
    "critical_claims_assessment": {"$ref": "#/definitions/criticalClaimsAssessment"},
    "narrative_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/narrativeEvidence"
      }
    },
    "external_reality_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/externalEvidence"
      }
    },
    "source_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/sourceRef"
      }
    },
    "claims_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/unsupportedClaim"
      }
    },
    "narrative_opportunities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/researchItem"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "multilingual_research": {"$ref": "#/definitions/multilingualResearch"},
    "research_pack_kind": {
      "type": "string",
      "enum": ["GENERIC", "PHENOMENON"],
      "description": "IR1-001: distingue un ResearchPack de fenómeno del genérico sin duplicar autoridad."
    },
    "phenomenon": {"$ref": "#/definitions/phenomenonScope"},
    "editorial_uses": {"$ref": "#/definitions/editorialUses"},
    "rival_analysis": {
      "type": "array",
      "items": {"$ref": "#/definitions/rivalAnalysis"}
    },
    "semantic_status": {"$ref": "#/definitions/semanticStatus"},
    "phenomenon_research_stop_decision_ref": {"type": "string", "minLength": 1},
    "aggregate_research_stop_decision_ref": {"type": "string", "minLength": 1},
    "required_component_decision_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "research_pack_stage": {"type": "string", "enum": ["RESEARCH_IN_PROGRESS", "RESEARCH_REVIEW_PENDING", "RESEARCH_COMPLETE"]},
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"research_pack_kind": {"const": "PHENOMENON"}},
        "required": ["research_pack_kind"]
      },
      "then": {
        "required": [
          "phenomenon",
          "editorial_uses",
          "rival_analysis",
          "semantic_status",
          "phenomenon_research_stop_decision_ref"
        ]
      }
    },
    {"if": {"properties": {"research_pack_stage": {"enum": ["RESEARCH_REVIEW_PENDING", "RESEARCH_COMPLETE"]}}, "required": ["research_pack_stage"]}, "then": {"required": ["aggregate_research_stop_decision_ref", "required_component_decision_refs"]}}
  ],
  "definitions": {
    "coverageEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_id", "status", "related_finding_ids", "related_source_ids", "limitation_or_pending", "scope_decision", "editorial_impact", "propagated_constraint", "mitigation_status"],
      "properties": {
        "dimension_id": {"type": "string", "enum": ["CENTRAL_QUESTION", "CONFLICT", "INITIAL_HYPOTHESIS", "HUMAN_SOCIAL_HISTORICAL_OR_CULTURAL_PHENOMENON", "PRIMARY_NARRATIVE_MATERIAL", "CRITICAL_CLAIMS", "ALTERNATIVE_PERSPECTIVES"]},
        "status": {"type": "string", "enum": ["COVERED", "PARTIALLY_COVERED", "PENDING", "NOT_VERIFIABLE"]},
        "related_finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "related_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "limitation_or_pending": {"type": ["string", "null"]}
        ,"scope_decision": {"type": "string", "enum": ["NONE", "REDUCED_SCOPE", "BLOCKED"]},
        "editorial_impact": {"type": "string", "enum": ["NOT_APPLICABLE", "NON_CRITICAL", "CRITICAL"]},
        "propagated_constraint": {"type": ["string", "null"]},
        "mitigation_status": {"type": "string", "enum": ["NOT_REQUIRED", "MITIGATED", "INSUFFICIENT"]}
      }
    },
    "criticalClaimsAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "claim_ids", "justification", "editorial_impact"],
      "properties": {
        "status": {"type": "string", "enum": ["IDENTIFIED", "NONE_JUSTIFIED"]},
        "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "justification": {"type": ["string", "null"]},
        "editorial_impact": {"type": "string", "enum": ["NONE", "LIMITED", "MATERIAL", "CRITICAL"]}
      }
    },
    "narrativeEvidence": {
      "allOf": [
        {"$ref": "#/definitions/researchItem"},
        {"properties": {"evidence_kind": {"type": "string", "enum": ["SCENE", "SEQUENCE", "DIALOGUE", "PASSAGE", "CHAPTER", "DECISION", "NARRATIVE_EVENT", "FORMAL_ELEMENT"]}}, "required": ["evidence_kind"]}
      ]
    },
    "externalEvidence": {
      "allOf": [
        {"$ref": "#/definitions/researchItem"},
        {"properties": {"evidence_kind": {"type": "string", "enum": ["STUDY", "DOCUMENT", "DATA", "STATEMENT", "HISTORICAL_RECORD", "INSTITUTIONAL_SOURCE", "VERIFIABLE_EVENT", "EXPERT_ANALYSIS"]}}, "required": ["evidence_kind"]}
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "source_type",
        "access_type",
        "locator",
        "confidence",
        "provenance"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "access_type": {
          "type": "string",
          "enum": [
            "DIRECT",
            "INDIRECT",
            "SECONDARY_ONLY"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "notes": {
          "type": "string"
        },
        "evidence_kind": {"type": "string"},
        "provenance": {"$ref": "#/definitions/sourceProvenance"}
      }
    },
    "researchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "statement",
        "source_refs",
        "locator",
        "confidence"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "material_id": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidence_kind": {
          "type": "string"
        }
      }
    },
    "unsupportedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "reason"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "attempted_source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "phenomenonScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phenomenon_id",
        "phenomenon_kind"
      ],
      "properties": {
        "phenomenon_id": {
          "type": "string",
          "minLength": 1
        },
        "phenomenon_kind": {
          "type": "string",
          "enum": [
            "HUMAN",
            "SOCIAL",
            "HISTORICAL",
            "CULTURAL",
            "PSYCHOLOGICAL",
            "NARRATIVE"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "editorialUses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_uses"
      ],
      "properties": {
        "intended_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
            "CENTRAL_CLAIM_SUPPORT",
            "SECONDARY_CONTEXT",
            "SENSITIVE_HANDLING",
              "CONTROVERSIAL_BALANCE",
              "NARRATIVE_MATERIAL",
              "CONTEXTUAL_BACKGROUND"
            ]
          }
        },
        "criticality_map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claims"],
          "properties": {
            "claims": {
              "type": "array",
              "items": {"$ref": "#/definitions/claimCriticality"}
            }
          }
        }
      }
    },
    "claimCriticality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "criticality",
        "intended_use"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "criticality": {
          "type": "string",
          "enum": [
            "CENTRAL",
            "SECONDARY",
            "SENSITIVE",
            "CONTROVERSIAL"
          ]
        },
        "intended_use": {
          "type": "string",
          "enum": [
            "CENTRAL_CLAIM_SUPPORT",
            "SECONDARY_CONTEXT",
            "SENSITIVE_HANDLING",
            "CONTROVERSIAL_BALANCE",
            "NARRATIVE_MATERIAL",
            "CONTEXTUAL_BACKGROUND"
          ]
        }
      }
    },
    "rivalAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rival_explanation_id",
        "statement",
        "agreement_status",
        "disagreement_kind",
        "claim_ids",
        "source_refs"
      ],
      "properties": {
        "rival_explanation_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "agreement_status": {
          "type": "string",
          "enum": [
            "CONSENSUS",
            "DISAGREEMENT",
            "COUNTEREXAMPLE",
            "UNCERTAINTY"
          ]
        },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "disagreement_kind": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "CONTROVERSY",
            "LIMITED",
            "RIVAL_OPEN",
            "INVESTIGATION_REQUIRED",
            "BLOCKED"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "semanticStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_per_claim",
        "ir4_dependency"
      ],
      "properties": {
        "status_per_claim": {
          "type": "array",
          "items": {"$ref": "#/definitions/semanticClaimStatus"}
        },
        "ir4_dependency": {
          "type": "string",
          "const": "DEFERRED_TO_R1_M6",
          "description": "IR1-006: la emisión de suficiencia funcional requiere IR4 (R1-M6). Este campo materializa solo la representación semántica."
        }
      }
    },
    "semanticClaimStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "semantic_level",
        "intended_use"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "semantic_level": {
          "type": "string",
          "enum": [
            "DEMONSTRATED",
            "PLAUSIBLE",
            "SPECULATIVE"
          ]
        },
        "intended_use": {
          "type": "string",
          "minLength": 1
        },
        "sufficiency_for_intended_use": {
          "type": ["string", "null"],
          "enum": ["NOT_FUNCTIONALLY_VALIDATED", "IR4_REQUIRED", null],
          "description": "IR1-006: representación no funcional; R1-M6 debe extender este enum antes de emitir suficiencia."
        }
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "version",
        "original_language",
        "derivative_language",
        "locator",
        "acquisition_method",
        "transformation_method",
        "transcription_type",
        "verification_status",
        "translation_transcription_risk",
        "limitations",
        "permitted_uses",
        "primary_verification_required",
        "primary_verification_performed",
        "claim_authority",
        "authority_domain",
        "official_primary"
      ],
      "properties": {
        "source_kind": {"type": "string", "enum": ["SOURCE_ORIGINAL", "TRANSCRIPT", "TRANSLATION", "SUMMARY", "REVIEW", "INDIRECT_QUOTE"]},
        "original_source_ref": {"type": ["string", "null"], "minLength": 1},
        "derived_from_source_ref": {"type": ["string", "null"], "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "original_language": {"type": "string", "minLength": 1},
        "derivative_language": {"type": ["string", "null"], "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "timestamp": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["start"],
          "properties": {"start": {"type": "string", "minLength": 1}, "end": {"type": ["string", "null"], "minLength": 1}}
        },
        "acquisition_method": {"type": "string", "minLength": 1},
        "transformation_method": {"type": "string", "minLength": 1},
        "transcription_type": {"type": "string", "enum": ["OFFICIAL", "CREATOR_PROVIDED", "AUTOMATIC", "MANUAL", "NOT_APPLICABLE"]},
        "verification_status": {"type": "string", "enum": ["NOT_REVIEWED", "REVIEWED", "PRIMARY_VERIFIED", "CREATOR_VERIFIED"]},
        "translation_transcription_risk": {"type": "string", "enum": ["NONE", "LOW", "MEDIUM", "HIGH", "MATERIAL"]},
        "material_transcription_error": {"type": "boolean"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "permitted_uses": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "primary_verification_required": {"type": "boolean"},
        "primary_verification_performed": {"type": "boolean"},
        "claim_authority": {"type": "string", "enum": ["PRIMARY", "SECONDARY", "INTERPRETIVE", "LOCAL_CONTEXT", "NONE"]},
        "authority_domain": {"type": "string", "enum": ["GENERAL", "YOUTUBE_ADAPTATION", "OTHER"]},
        "official_primary": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"source_kind": {"enum": ["TRANSCRIPT", "TRANSLATION", "SUMMARY", "REVIEW", "INDIRECT_QUOTE"]}}, "required": ["source_kind"]}, "then": {"required": ["original_source_ref", "derived_from_source_ref"]}},
        {"if": {"properties": {"source_kind": {"const": "TRANSCRIPT"}}, "required": ["source_kind"]}, "then": {"properties": {"transcription_type": {"enum": ["OFFICIAL", "CREATOR_PROVIDED", "AUTOMATIC", "MANUAL"]}}}},
        {"if": {"properties": {"source_kind": {"const": "SOURCE_ORIGINAL"}}, "required": ["source_kind"]}, "then": {"properties": {"original_source_ref": {"type": "null"}, "derived_from_source_ref": {"type": "null"}}}}
      ]
    },
    "multilingualResearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_status", "triggers", "non_trigger_examples", "affected_source_ids", "affected_claim_ids", "required_language", "material_risk", "consultation_result", "limitations", "invalidators", "return_route", "decision_basis"],
      "properties": {
        "activation_status": {"type": "string", "enum": ["ACTIVATED", "NOT_ACTIVATED", "REEVALUATION_REQUIRED"]},
        "triggers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["ORIGINAL_SOURCE_NOT_IN_SPANISH", "SPANISH_COVERAGE_DEPENDS_ON_DERIVATIVES", "MATERIAL_SOURCE_GAP", "TRANSLATION_SEMANTIC_RISK", "CONFLICTING_TRANSLATIONS", "LINGUISTICALLY_SPLIT_CONTROVERSY", "LOCAL_CONTEXT_REQUIRED", "AUTHORIAL_OR_CREATOR_STATEMENT", "PRIMARY_VERIFICATION_REQUIRED", "EVIDENCE_SUFFICIENCY_BLOCKED_BY_LANGUAGE"]}},
        "non_trigger_examples": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["FIXED_LANGUAGE_QUOTA", "SOURCE_VOLUME_ONLY", "OFFICIAL_TRANSLATION_SUFFICIENT", "DUPLICATED_FOREIGN_COVERAGE", "UNRELATED_INTERNATIONAL_PERSPECTIVE", "TRANSLATE_ALL_AUTOMATICALLY", "LANGUAGE_AS_AUTHORITY_SIGNAL", "NO_LINGUISTIC_DIFFERENCE_REQUIRED", "TECHNICAL_CAPABILITY_DEMO"]}},
        "affected_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_language": {"type": ["string", "null"], "minLength": 1},
        "material_risk": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["CLAIM_VALIDITY", "WORK_INTERPRETATION", "CONTRADICTION", "SUFFICIENCY", "WORK_SELECTION", "THESIS", "DISCLOSURE_OR_LIMITATION"]}},
        "consultation_result": {"type": "string", "enum": ["ORIGINAL_CONSULTED_RISK_RESOLVED", "LIMITED_BUT_USABLE", "MORE_RESEARCH_REQUIRED", "BLOCKED_BY_EVIDENCE", "CHANNEL_INTELLIGENCE_REVIEW_REQUIRED", "YOUTUBE_ADAPTATION_REVIEW_REQUIRED", "NOT_APPLICABLE"]},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "invalidators": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["CLAIM_OR_USE_CHANGED", "PRIMARY_SPANISH_SOURCE_RECOVERED", "AUTHORIZED_TRANSLATION_RESOLVES_RISK", "SAME_ORIGIN_DISCOVERED", "TRANSLATION_LINEAGE_OR_METHOD_LOST", "FOREIGN_SOURCE_LACKS_AUTHORITY", "VERSION_ADAPTATION_OR_CONTEXT_CHANGED", "NEW_CONTROVERSY_INTRODUCED", "TRANSLATED_CONTENT_NOT_VERIFIABLE", "LANGUAGE_QUERY_MASKS_GENERAL_INSUFFICIENCY"]}},
        "return_route": {"type": "string", "enum": ["ORIGINAL_CONSULTED_RISK_RESOLVED", "LIMITED_BUT_USABLE", "MORE_RESEARCH_REQUIRED", "BLOCKED_BY_EVIDENCE", "CHANNEL_INTELLIGENCE_REVIEW_REQUIRED", "YOUTUBE_ADAPTATION_REVIEW_REQUIRED", "NOT_APPLICABLE"]},
        "decision_basis": {"type": "string", "minLength": 1}
      }
    }
  }
}
