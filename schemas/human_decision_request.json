{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/human_decision_request.json",
  "title": "Human Decision Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "request_id", "episode_id", "prompt", "options", "recommendation", "created_at", "status", "request_checksum"],
  "properties": {
    "contract": {"const": "human_decision_request"},
    "contract_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "options": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}}},
    "recommendation": {"type": ["string", "null"]},
    "subject_ref": {"type": ["string", "null"]},
    "subject_version": {"type": ["string", "null"]},
    "subject_checksum": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "workflow_ref": {"type": ["string", "null"]},
    "expected_actor_ref": {"type": ["string", "null"]},
    "expected_channel": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PENDING", "RESPONSE_RECORDED", "RESOLVED", "STALE", "CANCELLED"]},
    "request_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status_updated_at": {"type": "string", "format": "date-time"}
  }
}
