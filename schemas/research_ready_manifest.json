{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/research_ready_manifest.json",
  "title": "ResearchReadyManifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "manifest_id",
    "episode_id",
    "research_id",
    "research_version",
    "research_ready_state",
    "state_bindings",
    "research_artifacts",
    "downstream_restrictions",
    "lineage",
    "created_at"
  ],
  "properties": {
    "contract": {"const": "research_ready_manifest"},
    "contract_version": {"const": "2.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "research_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "research_ready_state": {"type": "string", "enum": ["RESEARCH_READY", "RESEARCH_READY_WITH_LIMITATIONS", "NOT_RESEARCH_READY"]},
    "state_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_stage", "research_sufficiency", "artifact_validity"],
      "properties": {
        "research_stage": {"type": "string", "enum": ["PLANNING", "DISCOVERY", "BASE_RESEARCH", "PRELIMINARY_FIDELITY", "SELECTION", "DEEP_RESEARCH", "DEEP_FIDELITY", "SYNTHESIS", "REFINED", "READY"]},
        "research_sufficiency": {"type": "string", "enum": ["SUFFICIENT_FOR_INTENDED_USE", "LIMITED_BUT_USABLE", "MORE_RESEARCH_REQUIRED", "BLOCKED_BY_EVIDENCE"]},
        "artifact_validity": {"type": "string", "enum": ["VALID", "STALE", "INVALID", "PENDING_VALIDATION"]},
        "selection_state": {"type": "string", "enum": ["NOT_EVALUATED", "PENDING_DECISION", "CANDIDATE", "SELECTED", "EXCLUDED", "INVALIDATED"]},
        "deep_fidelity": {"type": "string", "enum": ["NOT_ASSESSED", "APROBADA", "APROBADA_CON_LIMITES", "MAS_INVESTIGACION_REQUERIDA", "NO_APROBADA"]}
      }
    },
    "research_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "artifact_kind", "artifact_version", "checksum"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "artifact_kind": {"type": "string", "minLength": 1},
          "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "checksum": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    },
    "downstream_restrictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["restriction_id", "kind", "statement", "affected_consumers"],
        "properties": {
          "restriction_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["CLAIM_ALLOWED", "CLAIM_LIMITED", "CLAIM_BLOCKED", "ATTRIBUTION_REQUIRED", "INTERPRETATION_ONLY", "NOT_AUTHORIZED", "CONDITION_REQUIRED"]},
          "statement": {"type": "string", "minLength": 1},
          "affected_consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "producer_contract", "producer_version"],
      "properties": {
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "producer_contract": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"research_ready_state": {"const": "RESEARCH_READY_WITH_LIMITATIONS"}}, "required": ["research_ready_state"]},
      "then": {"properties": {"downstream_restrictions": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"research_ready_state": {"const": "NOT_RESEARCH_READY"}}, "required": ["research_ready_state"]},
      "then": {"properties": {"state_bindings": {"properties": {"research_sufficiency": {"enum": ["MORE_RESEARCH_REQUIRED", "BLOCKED_BY_EVIDENCE"]}}}}}
    }
  ]
}
