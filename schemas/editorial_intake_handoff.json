{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/editorial_intake_handoff.json",
  "title": "Editorial Intake Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "target_contract", "status", "source_interaction_id", "source_channel", "entry_mode", "field_bindings", "unresolved_fields", "profile_binding", "provenance"],
  "properties": {
    "contract": {"const": "editorial_intake_handoff"},
    "contract_version": {"const": "1.0.0"},
    "target_contract": {"const": "topic_belonging_input"},
    "status": {"const": "AWAITING_EDITORIAL_ENRICHMENT"},
    "source_interaction_id": {"type": "string", "minLength": 1},
    "source_channel": {"type": "string", "minLength": 1},
    "entry_mode": {"enum": ["TOPIC_FIRST", "ANCHOR_WORK_FIRST", "CORPUS_FIRST"]},
    "field_bindings": {"type": "object"},
    "unresolved_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_checksum"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "profile_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "provenance": {"type": "object", "required": ["source_ref", "transformation", "editorial_decisions_made"], "properties": {"source_ref": {"type": "string", "minLength": 1}, "transformation": {"const": "BIND_USER_FIELDS_ONLY"}, "editorial_decisions_made": {"const": false}}}
  }
}
