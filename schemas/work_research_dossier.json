{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/work_research_dossier.json",
  "title": "WorkResearchDossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dossier_id",
    "dossier_version",
    "episode_id",
    "research_id",
    "evidence_report_id",
    "work",
    "dossier_stage",
    "pending_items",
    "confidence",
    "created_at"
  ],
  "properties": {
    "dossier_id": {"type": "string", "minLength": 1},
    "dossier_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "episode_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "evidence_report_id": {"type": "string", "minLength": 1},
    "work": {"$ref": "#/definitions/workIdentity"},
    "dossier_stage": {
      "type": "string",
      "enum": ["IDENTIFIED", "RESEARCH_IN_PROGRESS", "RESEARCH_REVIEW_PENDING"],
      "description": "IR1-008: lifecycle local del dossier; no sustituye el lifecycle global IR2/R1-M5."
    },
    "analysis_references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/analysisReference"}
    },
    "question_and_thesis_relation": {"$ref": "#/definitions/questionAndThesisRelation"},
    "claim_dispositions": {"$ref": "#/definitions/claimDispositions"},
    "overinterpretation_risk": {"$ref": "#/definitions/overinterpretationRisk"},
    "candidate_editorial_function_analysis_ref": {"type": "string", "minLength": 1},
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/locator"}
    },
    "pending_items": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
    "work_use_sufficiency": {"$ref": "#/definitions/workUseSufficiency"},
    "research_stop_decision_ref": {"type": "string", "minLength": 1},
    "independent_fidelity_audit": {"$ref": "#/definitions/independentFidelityAudit"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"dossier_stage": {"const": "RESEARCH_REVIEW_PENDING"}}, "required": ["dossier_stage"]},
      "then": {"required": ["analysis_references", "question_and_thesis_relation", "claim_dispositions", "overinterpretation_risk", "candidate_editorial_function_analysis_ref", "locators", "work_use_sufficiency", "independent_fidelity_audit"]}
    },
    {
      "if": {"properties": {"dossier_stage": {"const": "RESEARCH_REVIEW_PENDING"}}, "required": ["dossier_stage"]},
      "then": {"required": ["research_stop_decision_ref"]}
    }
  ],
  "definitions": {
    "workIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "title", "creator", "consulted_representations"],
      "properties": {
        "material_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "consulted_representations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/consultedRepresentation"}
        }
      }
    },
    "consultedRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation_kind", "edition_or_version", "consulted_locator"],
      "properties": {
        "representation_kind": {"type": "string", "enum": ["ORIGINAL_WORK", "ADAPTATION"]},
        "edition_or_version": {"type": "string", "minLength": 1},
        "consulted_locator": {"type": "string", "minLength": 1}
      }
    },
    "analysisReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_id", "material_id"],
      "properties": {
        "analysis_id": {"type": "string", "minLength": 1},
        "material_id": {"type": "string", "minLength": 1},
        "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifact_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "questionAndThesisRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["central_question_ref", "provisional_thesis_ref", "demonstrates_analysis_ref", "does_not_establish_analysis_ref", "main_interpretation_analysis_ref", "rival_interpretation_analysis_refs"],
      "properties": {
        "central_question_ref": {"type": "string", "minLength": 1},
        "provisional_thesis_ref": {"type": "string", "minLength": 1},
        "demonstrates_analysis_ref": {"type": "string", "minLength": 1},
        "does_not_establish_analysis_ref": {"type": "string", "minLength": 1},
        "main_interpretation_analysis_ref": {"type": "string", "minLength": 1},
        "rival_interpretation_analysis_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "claimDispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims_ledger_id", "authority_status", "candidate_allowed_claim_ids", "candidate_limited_claim_ids", "candidate_blocked_claim_ids"],
      "properties": {
        "claims_ledger_id": {"type": "string", "minLength": 1},
        "authority_status": {"type": "string", "const": "REPRESENTATION_ONLY_IR4_PENDING"},
        "candidate_allowed_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "candidate_limited_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "candidate_blocked_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "claims_ledger_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "claims_ledger_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "overinterpretationRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_id", "locator"],
      "properties": {
        "analysis_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "workUseSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_use", "status"],
      "properties": {
        "intended_use": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["NOT_FUNCTIONALLY_VALIDATED", "IR7_FIDELITY_AUDIT_REQUIRED"]}
      }
    },
    "independentFidelityAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_reference", "dependency"],
      "properties": {
        "audit_reference": {"type": "null"},
        "dependency": {"type": "string", "const": "FUNCTIONAL_DECISION_REQUIRED"}
      }
    }
  }
}
