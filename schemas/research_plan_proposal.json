  "properties": {
    "contract": {"const": "research_plan_proposal"},
    "contract_version": {"const": "1.0.0"},
    "central_question": {"type": "string", "minLength": 1},
    "intended_use": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "dimensions": {"type": "array", "minItems": 1, "items": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}},
    "subquestions": {"type": "array", "items": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}},
    "evidence_requirements": {"type": "array", "items": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}},
