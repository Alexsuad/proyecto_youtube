    "gaps_risks": {"type": "array", "items": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}},
    "potential_specialists": {"type": "array", "items": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}},
    "sufficiency_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_final_works_decision": {"type": "object"},
    "supplied_works": {"type": "array", "items": {"type": "object"}},
    "selection_policy": {"type": "object"},
    "planned_stages": {"type": "array", "items": {"type": "string", "minLength": 1}}
