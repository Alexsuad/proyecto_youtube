{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "B5I2SemanticSufficiencyAudit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "episode_id",
    "auditor_role",
    "auditor_run_id",
    "auditor_skill_id",
    "auditor_skill_version",
    "provider_or_adapter",
    "model_or_evaluator",
    "execution_timestamp",
    "input_manifest_checksum",
    "artifact_checksums",
    "audit_method",
    "findings",
    "decision",
    "created_at"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor_role": {
      "type": "string",
      "minLength": 1
    },
    "auditor_run_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor_skill_id": {
      "type": "string",
      "minLength": 1
    },
    "auditor_skill_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_or_adapter": {
      "type": "string",
      "minLength": 1
    },
    "model_or_evaluator": {
      "type": "string",
      "minLength": 1
    },
    "execution_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "input_manifest_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_checksums": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/definitions/artifact_checksum"
      }
    },
    "audit_method": {
      "const": "AI_SEMANTIC_REVIEW"
    },
    "findings": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/definitions/criterion_finding"
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCKED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "artifact_checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "artifact_id",
        "checksum",
        "producer_run_id"
      ],
      "properties": {
        "artifact_kind": {
          "enum": [
            "analysis",
            "curation",
            "thesis",
            "packaging"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer_run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_excerpt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "excerpt"
      ],
      "properties": {
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "anchored_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "artifact_id",
        "artifact_field",
        "evaluated_excerpt",
        "evidence_refs",
        "evidence_excerpts",
        "editorial_comparison",
        "why_specific_or_generic",
        "decision"
      ],
      "properties": {
        "artifact_kind": {
          "enum": [
            "analysis",
            "curation",
            "thesis",
            "packaging"
          ]
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_field": {
          "type": "string",
          "minLength": 1
        },
        "evaluated_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "evidence_excerpts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence_excerpt"
          }
        },
        "editorial_comparison": {
          "type": "string",
          "minLength": 1
        },
        "why_specific_or_generic": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "SATISFIED",
            "LIMITED",
            "NOT_SATISFIED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "criterion_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "status",
        "anchored_findings",
        "rationale"
      ],
      "properties": {
        "criterion": {
          "enum": [
            "ANALYSIS_SPECIFICITY",
            "MATERIAL_ANALYSIS_COVERAGE",
            "RIVAL_INTERPRETATION_AND_LIMITS",
            "INHERITED_RESTRICTION_PROPAGATION",
            "CURATION_COMPLETENESS",
            "CURATION_CONTRAST_AND_PROGRESSION",
            "THESIS_REFINEMENT_SUBSTANCE",
            "EVIDENCE_TRACEABILITY",
            "EARLY_PACKAGING_HONESTY"
          ]
        },
        "status": {
          "enum": [
            "SATISFIED",
            "LIMITED",
            "NOT_SATISFIED",
            "UNRESOLVED"
          ]
        },
        "anchored_findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/anchored_finding"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "criterion": {
                "enum": [
                  "ANALYSIS_SPECIFICITY",
                  "CURATION_CONTRAST_AND_PROGRESSION",
                  "THESIS_REFINEMENT_SUBSTANCE"
                ]
              }
            },
            "required": [
              "criterion"
            ]
          },
          "then": {
            "properties": {
              "anchored_findings": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
