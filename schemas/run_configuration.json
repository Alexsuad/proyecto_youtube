{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunConfiguration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_id",
    "execution_route",
    "execution_profile",
    "executor_override",
    "provider_override",
    "model_override",
    "timeout_seconds",
    "max_retries",
    "temperature",
    "max_tokens",
    "budget_limit",
    "paid_cost_approved"
  ],
  "properties": {
    "role_id": {"type": "string", "minLength": 1},
    "execution_route": {"type": "string", "minLength": 1},
    "execution_profile": {"type": "string", "minLength": 1},
    "executor_override": {"type": ["string", "null"], "minLength": 1},
    "provider_override": {"type": ["string", "null"], "minLength": 1},
    "model_override": {"type": ["string", "null"], "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_retries": {"type": "integer", "minimum": 0},
    "temperature": {"type": ["number", "null"]},
    "max_tokens": {"type": ["integer", "null"], "minimum": 1},
    "budget_limit": {"type": ["number", "integer", "null"], "minimum": 0},
    "paid_cost_approved": {"type": "boolean"}
  }
}