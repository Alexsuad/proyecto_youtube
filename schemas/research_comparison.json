{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/research_comparison.json",
  "title": "ResearchComparison V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_id",
    "comparison_version",
    "episode_id",
    "research_id",
    "candidate_work_ids",
    "dimensions",
    "entries",
    "decision_stage",
    "narrative_decision_made",
    "created_at"
  ],
  "properties": {
    "comparison_id": {"type": "string", "minLength": 1},
    "comparison_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "episode_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "candidate_work_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "CONTRIBUTION",
          "COVERAGE",
          "COMPLEMENTARITY",
          "REDUNDANCY",
          "CONTRAST",
          "FIDELITY",
          "LIMITATIONS",
          "EVIDENCE"
        ]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/comparisonEntry"}
    },
    "deepening_targets": {"$ref": "#/definitions/deepeningTargets"},
    "decision_stage": {"enum": ["INITIAL_RESEARCH_COMPARISON", "POST_DEEP_REEVALUATION"]},
    "narrative_decision_made": {"const": false},
    "selected_work_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "selection_mode": {"type": "string", "enum": ["USER_SELECTION", "DELEGATED_SELECTION"]},
    "selection_authority_ref": {"type": "string", "minLength": 1},
    "human_decision_required": {"type": "boolean"},
    "set_recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/setRecommendation"}
    },
    "substitution_research_requirements": {
      "type": "array",
      "items": {"$ref": "#/definitions/substitutionResearchRequirement"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "deepeningTargetSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "material_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rivals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contradictions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "risks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "intended_use": {"type": "string", "minLength": 1}
      }
    },
    "deepeningTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phenomenon", "works"],
      "properties": {
        "phenomenon": {"$ref": "#/definitions/deepeningTargetSet"},
        "works": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/definitions/deepeningTargetSet"}
        }
      }
    },
    "comparisonEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "evidence_refs",
        "contribution",
        "coverage",
        "complementarity",
        "redundancy",
        "contrast",
        "fidelity",
        "limitations"
      ],
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contribution": {"type": "string", "minLength": 1},
        "coverage": {"type": "string", "minLength": 1},
        "complementarity": {"type": "string", "minLength": 1},
        "redundancy": {"type": "string", "minLength": 1},
        "contrast": {"type": "string", "minLength": 1},
        "fidelity": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "missing_perspectives": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "overinterpretation_risk": {"type": "string", "minLength": 1}
      }
    },
    "setRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_id", "action", "affected_work_ids", "rationale", "evidence_refs", "material_change"],
      "properties": {
        "recommendation_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "enum": ["MAINTAIN", "REDUCE", "REMOVE", "REPLACE", "ADD"]},
        "affected_work_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "material_change": {"type": "boolean"}
      }
    },
    "substitutionResearchRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "status", "required_scopes"],
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "status": {"const": "RESEARCH_REQUIRED"},
        "required_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
