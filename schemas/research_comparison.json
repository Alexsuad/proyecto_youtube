{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/research_comparison.json",
  "title": "ResearchComparison V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_id",
    "comparison_version",
    "episode_id",
    "research_id",
    "candidate_work_ids",
    "dimensions",
    "entries",
    "decision_stage",
    "narrative_decision_made",
    "created_at"
  ],
  "properties": {
    "comparison_id": {"type": "string", "minLength": 1},
    "comparison_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "episode_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "candidate_work_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "CONTRIBUTION",
          "COVERAGE",
          "COMPLEMENTARITY",
          "REDUNDANCY",
          "CONTRAST",
          "FIDELITY",
          "LIMITATIONS",
          "EVIDENCE"
        ]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/comparisonEntry"}
    },
    "decision_stage": {"const": "INITIAL_RESEARCH_COMPARISON"},
    "narrative_decision_made": {"const": false},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "comparisonEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "evidence_refs",
        "contribution",
        "coverage",
        "complementarity",
        "redundancy",
        "contrast",
        "fidelity",
        "limitations"
      ],
      "properties": {
        "work_id": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contribution": {"type": "string", "minLength": 1},
        "coverage": {"type": "string", "minLength": 1},
        "complementarity": {"type": "string", "minLength": 1},
        "redundancy": {"type": "string", "minLength": 1},
        "contrast": {"type": "string", "minLength": 1},
        "fidelity": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
