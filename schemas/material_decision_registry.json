{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/material_decision_registry.json",
  "title": "MaterialDecisionRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "decisions",
    "legacy_files"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/materialDecision"
      }
    },
    "legacy_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/legacyFile"
      }
    }
  },
  "definitions": {
    "materialDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "subject_ref",
        "decision",
        "reason",
        "authority",
        "state",
        "evidence_refs",
        "recorded_at"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "enum": [
            "CHANNEL_INTELLIGENCE",
            "SCRIPT_PRODUCT",
            "YOUTUBE_ADAPTATION",
            "TECHNICAL_GOVERNANCE",
            "INFRASTRUCTURE_GOVERNANCE"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "VIGENTE",
            "HISTORICA",
            "SUSTITUIDA"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "authorization_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability_id",
            "controlled_demonstration",
            "general_activation",
            "product_use",
            "successor_capabilities"
          ],
          "properties": {
            "capability_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
            "controlled_demonstration": {"const": true},
            "general_activation": {"const": false},
            "product_use": {"const": false},
            "successor_capabilities": {"const": false}
          }
        }
      }
    },
    "legacyFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path",
        "decision_id",
        "estado",
        "autoridad_sucesor",
        "consumer_activo",
        "duplicacion_material",
        "disposicion",
        "ejecutable"
      ],
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "estado": {
          "type": "string",
          "enum": [
            "HISTORICA",
            "SUSTITUIDA"
          ]
        },
        "autoridad_sucesor": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "consumer_activo": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "duplicacion_material": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "disposicion": {
          "type": "string",
          "minLength": 1
        },
        "ejecutable": {
          "type": "boolean"
        }
      }
    }
  }
}
