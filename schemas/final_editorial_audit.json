{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/final_editorial_audit.json",
  "title": "FinalEditorialAudit",
  "type": "object",
  "required": [
    "episode_id",
    "artifact_id",
    "script_version",
    "script_checksum",
    "auditor_run_id",
    "independence_result",
    "profile_compliance",
    "brief_compliance",
    "packaging_promise_compliance",
    "evidence_sufficiency",
    "thesis_quality",
    "viewer_journey",
    "opening_quality",
    "progression",
    "coherence",
    "originality",
    "source_transformation",
    "voice",
    "orality",
    "closing_quality",
    "factual_traceability",
    "decision",
    "correction_route",
    "decision_basis",
    "dimension_evidence"
  ],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "script_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "script_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "auditor_run_id": {"type": "string", "minLength": 1},
    "independence_result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "profile_compliance": {
      "type": "string",
      "minLength": 1
    },
    "brief_compliance": {
      "type": "string",
      "minLength": 1
    },
    "packaging_promise_compliance": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sufficiency": {
      "type": "string",
      "minLength": 1
    },
    "thesis_quality": {
      "type": "string",
      "minLength": 1
    },
    "viewer_journey": {
      "$ref": "#/definitions/dimension_decision"
    },
    "opening_quality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "progression": {
      "$ref": "#/definitions/dimension_decision"
    },
    "coherence": {
      "$ref": "#/definitions/dimension_decision"
    },
    "originality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "source_transformation": {
      "$ref": "#/definitions/dimension_decision"
    },
    "voice": {
      "$ref": "#/definitions/dimension_decision"
    },
    "orality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "closing_quality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "factual_traceability": {
      "$ref": "#/definitions/dimension_decision"
    },
    "platform_risk": {
      "type": "string"
    },
    "production_readiness": {
      "type": "string"
    },
    "system_review": {
      "type": "string"
    },
    "product_review": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCKED"
      ]
    },
    "correction_route": {
      "type": "string"
    },
    "decision_basis": {
      "type": "string",
      "minLength": 1
    },
    "dimension_evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/dimension_evidence"
      }
    }
  },
  "definitions": {
    "dimension_evidence": {
      "type": "object",
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "justification": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {"required": ["rationale"]},
        {"required": ["observation"]},
        {"required": ["evidence_refs"]},
        {"required": ["justification"]}
      ]
    },
    "dimension_decision": {
      "type": "string",
      "enum": ["PASS", "WARN", "REQUEST_CHANGES", "BLOCK", "N/A_JUSTIFIED"]
    }
  }
}
