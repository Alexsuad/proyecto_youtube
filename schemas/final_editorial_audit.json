{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/final_editorial_audit.json",
  "title": "FinalEditorialAudit",
  "type": "object",
  "required": [
    "episode_id",
    "artifact_id",
    "script_version",
    "script_checksum",
    "auditor_run_id",
    "independence_result",
    "profile_compliance",
    "brief_compliance",
    "packaging_promise_compliance",
    "evidence_sufficiency",
    "thesis_quality",
    "viewer_journey",
    "opening_quality",
    "progression",
    "coherence",
    "originality",
    "source_transformation",
    "voice",
    "orality",
    "closing_quality",
    "factual_traceability",
    "decision",
    "correction_route",
    "decision_basis",
    "dimension_evidence"
  ],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "script_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "script_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "auditor_run_id": {"type": "string", "minLength": 1},
    "independence_result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "profile_compliance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "brief_compliance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "packaging_promise_compliance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_sufficiency": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "thesis_quality": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "viewer_journey": {
      "$ref": "#/definitions/dimension_decision"
    },
    "opening_quality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "progression": {
      "$ref": "#/definitions/dimension_decision"
    },
    "coherence": {
      "$ref": "#/definitions/dimension_decision"
    },
    "originality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "source_transformation": {
      "$ref": "#/definitions/dimension_decision"
    },
    "voice": {
      "$ref": "#/definitions/dimension_decision"
    },
    "orality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "closing_quality": {
      "$ref": "#/definitions/dimension_decision"
    },
    "factual_traceability": {
      "$ref": "#/definitions/dimension_decision"
    },
    "platform_risk": {
      "type": "string"
    },
    "production_readiness": {
      "type": "string"
    },
    "system_review": {
      "type": "string"
    },
    "product_review": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "BLOCKED"
      ]
    },
    "correction_route": {
      "type": "string"
    },
    "decision_basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "dimension_evidence": {
      "type": "object",
      "required": [
        "profile_compliance",
        "brief_compliance",
        "packaging_promise_compliance",
        "evidence_sufficiency",
        "thesis_quality",
        "viewer_journey",
        "opening_quality",
        "progression",
        "coherence",
        "originality",
        "source_transformation",
        "voice",
        "orality",
        "closing_quality",
        "factual_traceability"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/dimension_evidence"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["profile_compliance"],
        "properties": {"profile_compliance": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"profile_compliance": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["brief_compliance"],
        "properties": {"brief_compliance": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"brief_compliance": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["packaging_promise_compliance"],
        "properties": {"packaging_promise_compliance": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"packaging_promise_compliance": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["evidence_sufficiency"],
        "properties": {"evidence_sufficiency": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"evidence_sufficiency": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["thesis_quality"],
        "properties": {"thesis_quality": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"thesis_quality": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["viewer_journey"],
        "properties": {"viewer_journey": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"viewer_journey": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["opening_quality"],
        "properties": {"opening_quality": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"opening_quality": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["progression"],
        "properties": {"progression": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"progression": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["coherence"],
        "properties": {"coherence": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"coherence": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["originality"],
        "properties": {"originality": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"originality": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["source_transformation"],
        "properties": {"source_transformation": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"source_transformation": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["voice"],
        "properties": {"voice": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"voice": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["orality"],
        "properties": {"orality": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"orality": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["closing_quality"],
        "properties": {"closing_quality": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"closing_quality": {"required": ["justification"]}}}}}
    },
    {
      "if": {
        "required": ["factual_traceability"],
        "properties": {"factual_traceability": {"const": "N/A_JUSTIFIED"}}
      },
      "then": {"properties": {"dimension_evidence": {"properties": {"factual_traceability": {"required": ["justification"]}}}}}
    }
  ],
  "definitions": {
    "dimension_evidence": {
      "type": "object",
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "observation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "anyOf": [
        {"required": ["rationale"]},
        {"required": ["observation"]},
        {"required": ["evidence_refs"]},
        {"required": ["justification"]}
      ]
    },
    "dimension_decision": {
      "type": "string",
      "enum": ["PASS", "WARN", "REQUEST_CHANGES", "BLOCK", "N/A_JUSTIFIED"]
    }
  }
}
