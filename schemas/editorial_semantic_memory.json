{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/editorial_semantic_memory.json",
  "title": "EditorialSemanticMemory",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_id", "memory_version", "history_source", "consultation_points", "checkpoint_integration", "episode_entries", "comparison_decisions", "created_at"],
  "properties": {
    "memory_id": {"type": "string", "minLength": 1},
    "memory_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "history_source": {"const": "REPOSITORY_GOVERNED_ARTIFACTS"},
    "consultation_points": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "enum": ["PROPOSAL", "PRE_FINAL_CURATION", "PRE_THESIS_OR_ARCHITECTURE", "OPENING_UNIT_REVIEW", "PRE_FINAL_SCRIPT"]}},
    "checkpoint_integration": {"type": "object", "additionalProperties": false, "required": ["PROPOSAL", "PRE_FINAL_CURATION", "PRE_THESIS_OR_ARCHITECTURE", "OPENING_UNIT_REVIEW", "PRE_FINAL_SCRIPT"], "properties": {"PROPOSAL": {"enum": ["CONNECTED"]}, "PRE_FINAL_CURATION": {"enum": ["CONNECTED"]}, "PRE_THESIS_OR_ARCHITECTURE": {"enum": ["CONNECTED"]}, "OPENING_UNIT_REVIEW": {"enum": ["PREPARED_DEFERRED_UNTIL_CANONICAL_OPENING_UNIT_REVIEW"]}, "PRE_FINAL_SCRIPT": {"enum": ["PREPARED_DEFERRED_UNTIL_CANONICAL_FINAL_SCRIPT_APPROVAL"]}}},
    "episode_entries": {"type": "array", "items": {"$ref": "#/definitions/episodeEntry"}},
    "comparison_decisions": {"type": "array", "items": {"$ref": "#/definitions/comparisonDecision"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "definitions": {
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["artifact_ref", "version", "checksum"], "properties": {"artifact_ref": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "episodeEntry": {"type": "object", "additionalProperties": false, "required": ["episode_id", "artifact_refs", "dimensions"], "properties": {"episode_id": {"type": "string", "minLength": 1}, "artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/artifactRef"}}, "dimensions": {"$ref": "#/definitions/dimensions"}}},
    "dimensions": {"type": "object", "additionalProperties": false, "required": ["topic", "central_question", "thesis", "explanatory_mechanism", "conclusion", "works", "scenes_or_passages", "work_functions", "work_order", "work_combination", "claims", "interpretations", "specialists", "sources", "narrative_architecture", "analogies", "opening_unit", "editorial_promise"], "properties": {"topic": {"type": "string"}, "central_question": {"type": "string"}, "thesis": {"type": "string"}, "explanatory_mechanism": {"type": "string"}, "conclusion": {"type": "string"}, "works": {"type": "array", "items": {"type": "string"}}, "scenes_or_passages": {"type": "array", "items": {"type": "string"}}, "work_functions": {"type": "array", "items": {"type": "string"}}, "work_order": {"type": "array", "items": {"type": "string"}}, "work_combination": {"type": "string"}, "claims": {"type": "array", "items": {"type": "string"}}, "interpretations": {"type": "array", "items": {"type": "string"}}, "specialists": {"type": "array", "items": {"type": "string"}}, "sources": {"type": "array", "items": {"type": "string"}}, "narrative_architecture": {"type": "string"}, "analogies": {"type": "array", "items": {"type": "string"}}, "opening_unit": {"type": ["string", "null"]}, "editorial_promise": {"type": ["string", "null"]}}},
    "comparisonDecision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "candidate_episode_ref", "compared_episode_refs", "evidence_refs", "comparison_dimensions", "decision", "recommended_action", "justification", "invalidators"], "properties": {"decision_id": {"type": "string", "minLength": 1}, "candidate_episode_ref": {"$ref": "#/definitions/artifactRef"}, "compared_episode_refs": {"type": "array", "items": {"$ref": "#/definitions/artifactRef"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "comparison_dimensions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "enum": ["topic", "central_question", "thesis", "explanatory_mechanism", "conclusion", "works", "scenes_or_passages", "work_functions", "work_order", "work_combination", "claims", "interpretations", "specialists", "sources", "narrative_architecture", "analogies", "opening_unit", "editorial_promise"]}}, "decision": {"type": "string", "enum": ["NOVEL_ENOUGH", "RELATED_BUT_DISTINCT", "INTENTIONAL_CONTINUATION", "REUSE_REQUIRES_JUSTIFICATION", "TOO_SIMILAR", "INSUFFICIENT_HISTORY"]}, "recommended_action": {"type": "string", "enum": ["NO_ACTION", "REVIEW_REQUIRED", "JUSTIFICATION_REQUIRED", "CONTINUATION_REFERENCE_REQUIRED"]}, "continuation_or_reuse": {"type": ["object", "null"], "additionalProperties": false, "required": ["prior_artifact_ref", "what_is_reused", "reason", "new_difference", "repetition_risk"], "properties": {"prior_artifact_ref": {"type": "string", "minLength": 1}, "what_is_reused": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "new_difference": {"type": "string", "minLength": 1}, "repetition_risk": {"type": "string", "minLength": 1}}}, "justification": {"type": "string", "minLength": 1}, "invalidators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "allOf": [{"$ref": "#/definitions/decisionRules"}]},
    "decisionRules": {"allOf": [{"if": {"properties": {"decision": {"const": "TOO_SIMILAR"}}, "required": ["decision"]}, "then": {"properties": {"recommended_action": {"const": "REVIEW_REQUIRED"}}}}, {"if": {"properties": {"decision": {"enum": ["INTENTIONAL_CONTINUATION", "REUSE_REQUIRES_JUSTIFICATION"]}}, "required": ["decision"]}, "then": {"required": ["continuation_or_reuse"], "properties": {"continuation_or_reuse": {"type": "object"}}}}, {"if": {"properties": {"decision": {"const": "INSUFFICIENT_HISTORY"}}, "required": ["decision"]}, "then": {"properties": {"recommended_action": {"const": "REVIEW_REQUIRED"}}}}]}
  }
}
