      "type": "object",
      "additionalProperties": false,
      "required": [
        "DOES_NOT_AUTHORIZE"
      ],
      "properties": {
        "DOES_NOT_AUTHORIZE": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "B5_I3",
              "FINAL_PACKAGING",
              "PRODUCTION",
              "PUBLICATION",
              "MONETIZATION_GUARANTEE",
              "LEGAL_APPROVAL"
            ]
          }
        }
      }
    },
    "strategic_return": {"type": "object", "additionalProperties": false, "required": ["return_required", "target_domain", "strategic_triggers", "reason", "evidence_refs"], "properties": {"return_required": {"type": "boolean"}, "target_domain": {"type": ["string", "null"], "enum": ["CHANNEL_INTELLIGENCE", null]}, "strategic_triggers": {"type": "object", "additionalProperties": {"type": "boolean"}}, "reason": {"type": ["string", "null"]}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
