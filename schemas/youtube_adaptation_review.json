      "properties": {
        "decision": {
          "enum": [
            "PASS",
            "WARN",
            "REQUEST_CHANGES",
            "BLOCK"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "recommended_range": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:(?:entre\\s+[0-9]+(?:[.,][0-9]+)?\\s+y\\s+[0-9]+(?:[.,][0-9]+)?)|(?:[0-9]+(?:[.,][0-9]+)?\\s*[-–—]\\s*[0-9]+(?:[.,][0-9]+)?))(?:\\s*(?:minuto|minutos|mins?|min))?$"
        }
