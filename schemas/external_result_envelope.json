{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "External Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "package_checksum",
    "input_manifest_checksum",
    "skill_id",
    "skill_version",
    "mission_id",
    "episode_id",
    "capability_id",
    "stage",
    "role",
    "result_run_id",
    "output",
    "output_checksum",
    "provenance"
  ],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "package_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "input_manifest_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "skill_id": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["ENRICHMENT", "PRODUCER", "REVIEWER"]},
    "role": {"type": "string", "minLength": 1},
    "result_run_id": {"type": "string", "minLength": 1},
    "output": {"type": "object"},
    "output_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "episode_id", "capability_id", "stage", "role", "run_id", "executor_identity"],
      "properties": {
        "mission_id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "capability_id": {"type": "string", "minLength": 1},
        "stage": {"enum": ["ENRICHMENT", "PRODUCER", "REVIEWER"]},
        "role": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "executor_identity": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
