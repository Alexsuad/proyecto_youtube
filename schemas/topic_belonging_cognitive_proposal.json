{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic Belonging Cognitive Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposed_angle",
    "proposed_territory",
    "initial_evidence",
    "strategic_triggers"
  ],
  "properties": {
    "proposed_angle": {
      "type": "string",
      "minLength": 1
    },
    "proposed_territory": {
      "type": "string",
      "minLength": 1
    },
    "initial_evidence": {
      "type": "array",
      "minItems": 1
    },
    "strategic_triggers": {
      "$ref": "#/$defs/strategic_triggers"
    },
    "proposed_topic": {
      "type": "string",
      "minLength": 1
    },
    "proposed_central_question": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "strategic_triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "political_partisan_sensitivity",
        "high_sensitivity",
        "audience_matrix_change",
        "excluded_boundary_reinterpretation",
        "new_personal_exposure",
        "voice_or_author_persona_change",
        "positioning_expansion",
        "permanent_effect",
        "high_precedent_risk",
        "experimental_territory"
      ],
      "properties": {
        "political_partisan_sensitivity": {"type": "boolean"},
        "high_sensitivity": {"type": "boolean"},
        "audience_matrix_change": {"type": "boolean"},
        "excluded_boundary_reinterpretation": {"type": "boolean"},
        "new_personal_exposure": {"type": "boolean"},
        "voice_or_author_persona_change": {"type": "boolean"},
        "positioning_expansion": {"type": "boolean"},
        "permanent_effect": {"type": "boolean"},
        "high_precedent_risk": {"type": "boolean"},
        "experimental_territory": {"type": "boolean"}
      }
    }
  }
}
