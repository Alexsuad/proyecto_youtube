{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/episode_brief.json",
  "title": "EpisodeBrief",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "brief_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "brief_stage": {"enum": ["PRE_RESEARCH", "EDITORIAL_ENRICHED"]},
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile_checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tema": {
      "type": "string",
      "minLength": 1
    },
    "pregunta_central": {
      "type": "string",
      "minLength": 1
    },
    "initial_question": {"type": ["string", "null"]},
    "conflicto_o_tension": {
      "type": "string",
      "minLength": 1
    },
    "initial_editorial_hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "status",
        "research_role",
        "revisable",
        "adversarial_research_required"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "HYPOTHESIS_UNAPPROVED"
          ]
        },
        "research_role": {
          "type": "string",
          "enum": [
            "ORIENTS_RESEARCH_NOT_APPROVED_THESIS"
          ]
        },
        "revisable": {
          "type": "boolean",
          "const": true
        },
        "adversarial_research_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "objetivo": {
      "type": "string",
      "minLength": 1
    },
    "intended_use_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "origin"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "origin": {"type": "string", "enum": ["OWNER_EXPLICIT", "DERIVED_STANDARD"]},
        "reference": {"type": ["string", "null"]}
      }
    },
    "transformacion_esperada": {
      "type": "string",
      "minLength": 1
    },
    "audiencia_concreta": {
      "type": "string",
      "minLength": 1
    },
    "audience_status": {
      "type": "string",
      "enum": [
        "INITIAL_HYPOTHESIS"
      ]
    },
    "angulo_diferencial": {
      "type": "string",
      "minLength": 1
    },
    "alcance": {
      "type": "string",
      "minLength": 1
    },
    "fuera_de_alcance": {
      "type": "string",
      "minLength": 1
    },
    "spoilers": {
      "type": "string",
      "enum": [
        "NO",
        "SI_LIMITADOS",
        "SI_COMPLETOS"
      ]
    },
    "tono": {
      "type": "string",
      "minLength": 1
    },
    "duracion_objetivo": {
      "type": "string",
      "minLength": 1
    },
    "ritmo_locucion": {
      "type": "string",
      "minLength": 1
    },
    "nivel_investigacion": {
      "type": "string",
      "enum": [
        "BASICO",
        "ESTANDAR",
        "PROFUNDO",
        "CRITICO"
      ]
    },
    "fuentes_requeridas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "narrative_materials": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "work_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_ref", "editorial_intent"],
        "properties": {
          "work_ref": {"type": "string", "minLength": 1},
          "editorial_intent": {"enum": ["NO_DECLARADA", "PREFERIDA", "REQUERIDA"]}
        }
      }
    },
    "selection_authority": {"enum": ["NOT_DECLARED", "OWNER_DECIDES", "DELEGATED_TO_RESEARCH"]},
    "owner_material_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "owner_restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tipo_de_guion_principal": {
      "type": "string",
      "minLength": 1
    },
    "tipo_de_guion_secundario": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "estructura_candidata": {
      "type": "string",
      "minLength": 1
    },
    "structure_status": {
      "type": "string",
      "enum": [
        "INITIAL_HYPOTHESIS_REVISABLE_AFTER_RESEARCH"
      ]
    },
    "razon_eleccion_estructura": {
      "type": "string",
      "minLength": 1
    },
    "citation_style": {
      "type": "string",
      "minLength": 1
    },
    "attribution_policy": {
      "type": "string",
      "minLength": 1
    },
    "quotation_policy": {
      "type": "string",
      "minLength": 1
    },
    "source_visibility": {
      "type": "string",
      "enum": [
        "INTERNAL_ONLY",
        "PUBLIC_SUMMARY",
        "PUBLIC_DETAILED"
      ]
    },
    "salida_esperada": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "topic_belonging_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "topic_belonging_decision_checksum": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"brief_stage": {"const": "PRE_RESEARCH"}}, "required": ["brief_stage"]},
      "then": {"required": ["episode_id", "brief_version", "brief_stage", "profile_id", "profile_version", "profile_checksum", "tema", "initial_question", "objetivo", "narrative_materials", "work_intents", "selection_authority", "owner_material_refs", "owner_restrictions", "created_at"], "properties": {"narrative_materials": {"minItems": 0}}},
      "else": {"required": ["episode_id", "brief_version", "profile_id", "profile_version", "profile_checksum", "tema", "pregunta_central", "conflicto_o_tension", "initial_editorial_hypothesis", "objetivo", "transformacion_esperada", "audiencia_concreta", "audience_status", "angulo_diferencial", "alcance", "fuera_de_alcance", "spoilers", "tono", "duracion_objetivo", "ritmo_locucion", "nivel_investigacion", "narrative_materials", "tipo_de_guion_principal", "estructura_candidata", "structure_status", "razon_eleccion_estructura", "citation_style", "attribution_policy", "quotation_policy", "source_visibility", "salida_esperada", "created_at"], "properties": {"narrative_materials": {"minItems": 1}}}
    }
  ]
}
