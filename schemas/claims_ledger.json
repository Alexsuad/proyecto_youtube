{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/claims_ledger.json",
  "title": "ClaimsLedger",
  "type": "object",
  "required": [
    "ledger_id",
    "script_version",
    "claims"
  ],
  "properties": {
    "ledger_id": {
      "type": "string"
    },
    "script_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "script_location",
          "claim_text",
          "claim_type",
          "source_refs",
          "verification_status"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "script_location": {
            "type": "string"
          },
          "claim_text": {
            "type": "string"
          },
          "claim_type": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "evidence_excerpt": {
            "type": "string"
          },
          "attribution_required": {
            "type": "boolean"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "REJECTED",
              "RECLASSIFIED"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "limitations": {
            "type": "string"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "CENTRAL",
              "SECONDARY",
              "SENSITIVE",
              "CONTROVERSIAL"
            ],
            "description": "IR1-002: tipificación de criticidad ligada al uso editorial previsto."
          },
          "intended_use": {
            "type": "string",
            "enum": [
              "CENTRAL_CLAIM_SUPPORT",
              "SECONDARY_CONTEXT",
              "SENSITIVE_HANDLING",
              "CONTROVERSIAL_BALANCE",
              "NARRATIVE_MATERIAL",
              "CONTEXTUAL_BACKGROUND",
              "EXACT_QUOTE",
              "PROVE_WORK_CONTENT",
              "YOUTUBE_POLICY"
            ],
            "description": "IR1-002: uso editorial previsto de la claim, ligado a su criticidad."
          },
          "provenance_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "provenance_status": {
            "type": "string",
            "enum": ["PRIMARY_VERIFIED", "DERIVED_LIMITED", "BLOCKED"]
          },
          "authority_basis": {
            "type": "string",
            "enum": ["PRIMARY_SOURCE", "YOUTUBE_OFFICIAL_PRIMARY", "SECONDARY_ONLY", "INTERPRETIVE_ONLY", "NOT_APPLICABLE"]
          }
      }
    }
  }
}
}
