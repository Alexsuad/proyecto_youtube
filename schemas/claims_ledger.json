{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/claims_ledger.json",
  "title": "ClaimsLedger",
  "type": "object",
  "required": [
    "ledger_id",
    "claims"
  ],
  "properties": {
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "script_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim_text",
          "claim_type",
          "source_refs",
          "verification_status",
          "materiality"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "script_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "work_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "external_reality_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "supporting_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "limiting_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "refuting_evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "rival_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "contradiction_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "pending_matters": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "decision_basis": {"type": "string", "minLength": 1},
          "return_route": {"type": "string", "minLength": 1},
          "return_route_code": {
            "type": "string",
            "enum": [
              "AUTHORIZE_INTENDED_USE_ONLY",
              "RESTRICT_FORMULATION_AND_DISCLOSE",
              "RETURN_TO_RESEARCH",
              "REMOVE_REPLACE_OR_REFORMULATE",
              "CHANNEL_INTELLIGENCE_REVIEW_REQUIRED",
              "YOUTUBE_ADAPTATION_REVIEW_REQUIRED",
              "RETURN_TO_ORIGIN_ARTIFACT",
              "NOT_APPLICABLE"
            ]
          },
          "evidence_excerpt": {
            "type": "string"
          },
          "attribution_required": {
            "type": "boolean"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "REJECTED",
              "RECLASSIFIED"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "limitations": {
            "type": "string"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "CENTRAL",
              "SECONDARY",
              "SENSITIVE",
              "CONTROVERSIAL"
            ],
            "description": "IR1-002: tipificación de criticidad ligada al uso editorial previsto."
          },
          "intended_use": {
            "type": "string",
            "enum": [
              "CENTRAL_CLAIM_SUPPORT",
              "SECONDARY_CONTEXT",
              "SENSITIVE_HANDLING",
              "CONTROVERSIAL_BALANCE",
              "NARRATIVE_MATERIAL",
              "CONTEXTUAL_BACKGROUND",
              "EXACT_QUOTE",
              "PROVE_WORK_CONTENT",
              "YOUTUBE_POLICY"
            ],
            "description": "IR1-002: uso editorial previsto de la claim, ligado a su criticidad."
          },
          "provenance_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "provenance_status": {
            "type": "string",
            "enum": [
              "PRIMARY_VERIFIED",
              "DERIVED_LIMITED",
              "BLOCKED"
            ]
          },
          "authority_basis": {
            "type": "string",
            "enum": [
              "PRIMARY_SOURCE",
              "YOUTUBE_OFFICIAL_PRIMARY",
              "SECONDARY_ONLY",
              "INTERPRETIVE_ONLY",
              "NOT_APPLICABLE"
            ]
          },
          "claim_decision": {
            "type": "string",
            "enum": [
              "CLAIM_ALLOWED",
              "CLAIM_LIMITED",
              "CLAIM_BLOCKED"
            ]
          },
          "research_sufficiency": {
            "type": "string",
            "enum": [
              "SUFFICIENT_FOR_INTENDED_USE",
              "LIMITED_BUT_USABLE",
              "MORE_RESEARCH_REQUIRED",
              "BLOCKED_BY_EVIDENCE"
            ]
          },
          "materiality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "is_material",
              "activation_criteria",
              "non_trigger_examples",
              "invalidator_codes",
              "return_route_code",
              "decision_ref"
            ],
            "properties": {
              "is_material": {
                "type": "boolean"
              },
              "activation_criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "THESIS_DEPENDENCY",
                    "CENTRAL_ARGUMENT_DEPENDENCY",
                    "WORK_SELECTION_DEPENDENCY",
                    "WORK_FIDELITY",
                    "CAUSAL_OR_PSYCHOLOGICAL_EXPLANATION",
                    "AUTHORIAL_INTENT",
                    "SENSITIVE_OR_HARMFUL_ASSERTION",
                    "NUMERICAL_OR_HISTORICAL_ASSERTION",
                    "CONTROVERSIAL_OR_DISPUTED_ASSERTION",
                    "VISIBLE_PROMISE_DEPENDENCY",
                    "OPENING_OR_CONCLUSION_DEPENDENCY",
                    "REPUTATIONAL_OR_ETHICAL_RISK",
                    "TRANSLATION_OR_TRANSCRIPTION_DEPENDENCY",
                    "RIVAL_READING_IMPACT",
                    "REUSE_ORIGINALITY_DEPENDENCY"
                  ]
                },
                "uniqueItems": true
              },
              "non_trigger_examples": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "invalidator_codes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "CLAIM_OR_SCOPE_CHANGED",
                    "INTENDED_USE_CHANGED",
                    "MOVED_TO_OPENING_OR_CONCLUSION",
                    "ADDED_TO_PACKAGING_OR_PROMISE",
                    "THESIS_CHANGED",
                    "WORK_VERSION_OR_ADAPTATION_CHANGED",
                    "NEW_MATERIAL_EVIDENCE",
                    "SOURCE_WITHDRAWN_OR_STALE",
                    "UNDECLARED_SOURCE_DERIVATION",
                    "MATERIAL_CONTRADICTION_FOUND",
                    "TRANSLATION_OR_TRANSCRIPTION_CHANGED",
                    "SENSITIVITY_OR_RISK_INCREASED",
                    "CAUSALITY_STRENGTHENED",
                    "LIMITATION_OR_DISCLOSURE_REMOVED",
                    "EDITORIAL_CONTEXT_CHANGED"
                  ]
                },
                "uniqueItems": true
              },
              "return_route_code": {
                "type": "string",
                "enum": [
                  "AUTHORIZE_INTENDED_USE_ONLY",
                  "RESTRICT_FORMULATION_AND_DISCLOSE",
                  "RETURN_TO_RESEARCH",
                  "REMOVE_REPLACE_OR_REFORMULATE",
                  "CHANNEL_INTELLIGENCE_REVIEW_REQUIRED",
                  "YOUTUBE_ADAPTATION_REVIEW_REQUIRED",
                  "RETURN_TO_ORIGIN_ARTIFACT",
                  "NOT_APPLICABLE"
                ]
              },
              "decision_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "is_material": {
                      "const": true
                    }
                  },
                  "required": [
                    "is_material"
                  ]
                },
                "then": {
                  "properties": {
                    "activation_criteria": {
                      "minItems": 1
                    },
                    "decision_ref": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "is_material": {
                      "const": false
                    }
                  },
                  "required": [
                    "is_material"
                  ]
                },
                "then": {
                  "properties": {
                    "activation_criteria": {
                      "minItems": 0
                    },
                    "decision_ref": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "criticality": {
                  "enum": [
                    "CENTRAL",
                    "SENSITIVE",
                    "CONTROVERSIAL"
                  ]
                }
              },
              "required": [
                "criticality"
              ]
            },
            "then": {
              "required": [
                "materiality"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "intended_use": {
                  "enum": [
                    "CENTRAL_CLAIM_SUPPORT",
                    "SENSITIVE_HANDLING",
                    "CONTROVERSIAL_BALANCE",
                    "EXACT_QUOTE",
                    "PROVE_WORK_CONTENT",
                    "YOUTUBE_POLICY"
                  ]
                }
              },
              "required": [
                "intended_use"
              ]
            },
            "then": {
              "required": [
                "materiality"
              ]
            }
          }
        ]
      }
    },
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "2.0.0"
      ]
    },
    "ledger_stage": {
      "type": "string",
      "enum": [
        "RESEARCH_PRE_SCRIPT",
        "SCRIPT_BOUND"
      ]
    },
    "research_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lineage": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_type_separation": {
      "$ref": "#/definitions/evidenceTypeSeparation"
    },
    "rival_explanations": {
      "type": "array",
      "items": {"$ref": "#/definitions/rivalExplanation"}
    },
    "contradictions": {
      "type": "array",
      "items": {"$ref": "#/definitions/ledgerContradiction"}
    },
    "gaps": {
      "type": "array",
      "items": {"$ref": "#/definitions/ledgerGap"}
    },
    "consolidation_stage": {
      "const": "POST_DEEP"
    }
  },
  "definitions": {
    "evidenceTypeSeparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_evidence_refs", "external_reality_evidence_refs"],
      "properties": {
        "work_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "external_reality_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rivalExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rival_id", "statement", "affected_claim_ids", "evidence_refs", "material_impact", "disposition"],
      "properties": {
        "rival_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "affected_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "material_impact": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "ledgerContradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradiction_id", "statement", "source_refs", "subject_kind", "subject_ref", "affected_use",
        "conflicting_source_refs", "discrepancy_kind", "materiality", "disposition", "compared_positions",
        "decision_evidence_refs", "contrary_evidence_refs", "disposition_justification", "return_route",
        "return_route_code", "invalidator_codes", "evidence_refs", "status", "resolution_or_limit"
      ],
      "properties": {
        "contradiction_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "subject_kind": {"type": "string", "enum": ["PHENOMENON", "WORK_RESEARCH_DOSSIER", "WORK_INTERPRETATION", "MATERIAL_CLAIM", "THESIS", "NARRATIVE_ARCHITECTURE", "OPENING_UNIT", "EDITORIAL_PROMISE", "OTHER"]},
        "subject_ref": {"type": "string", "minLength": 1},
        "subject_state": {"type": "string", "minLength": 1},
        "subject_version": {"type": "string", "minLength": 1},
        "subject_formulation": {"type": "string", "minLength": 1},
        "affected_use": {"type": "string", "minLength": 1},
        "affected_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "conflicting_source_refs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "discrepancy_kind": {"type": "string", "enum": ["FACTUAL", "INTERPRETIVE", "CAUSAL", "SCOPE", "VERSION", "TRANSLATION", "OTHER"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "materiality": {"type": "string", "enum": ["MATERIAL", "CRITICAL", "NON_MATERIAL"]},
        "disposition": {"type": "string", "enum": ["RESOLVED", "CONTROVERSY", "LIMITED", "RIVAL", "INVESTIGATION_REQUIRED", "BLOCKED"]},
        "compared_positions": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/contradictionPosition"}},
        "decision_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contrary_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "disposition_justification": {"type": "string", "minLength": 1},
        "remaining_limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "pending_matters": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "return_route": {"type": "string", "minLength": 1},
        "return_route_code": {"type": "string", "enum": ["AUTHORIZE_INTENDED_USE_ONLY", "RESTRICT_FORMULATION_AND_DISCLOSE", "RETURN_TO_RESEARCH", "REMOVE_REPLACE_OR_REFORMULATE", "CHANNEL_INTELLIGENCE_REVIEW_REQUIRED", "YOUTUBE_ADAPTATION_REVIEW_REQUIRED", "RETURN_TO_ORIGIN_ARTIFACT", "NOT_APPLICABLE"]},
        "invalidator_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dependent_artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "revalidation_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"type": "string", "enum": ["OPEN", "TREATED", "UNRESOLVED"]},
        "resolution_or_limit": {"type": "string", "minLength": 1}
      }
    },
    "contradictionPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_id", "statement", "source_refs", "treatment"],
      "properties": {
        "position_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "treatment": {"type": "string", "enum": ["RETAINED", "LIMITED", "REJECTED", "OPEN", "INVESTIGATE", "BLOCKED"]}
      }
    },
    "ledgerGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "statement", "affected_claim_ids", "evidence_refs", "materiality", "status", "return_route"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "affected_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "materiality": {"type": "string", "enum": ["MATERIAL", "NON_MATERIAL"]},
        "status": {"type": "string", "enum": ["OPEN", "LIMITED_BUT_USABLE", "RESOLVED", "BLOCKED_BY_EVIDENCE"]},
        "return_route": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ledger_stage": {
            "const": "RESEARCH_PRE_SCRIPT"
          }
        },
        "required": [
          "ledger_stage"
        ]
      },
      "then": {
        "required": [
          "research_id",
          "episode_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ledger_stage": {
            "const": "SCRIPT_BOUND"
          }
        },
        "required": [
          "ledger_stage"
        ]
      },
      "then": {
        "required": [
          "script_version"
        ]
      }
    }
  ]
}
