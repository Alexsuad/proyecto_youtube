{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/editorial_edit_report.json",
  "title": "EditorialEditReport",
  "type": "object",
  "required": [
    "episode_id",
    "input_artifact_id",
    "input_checksum",
    "output_artifact_id",
    "output_checksum",
    "input_version",
    "output_version",
    "edit_type",
    "changes_by_category",
    "continuity_findings",
    "redundancy_findings",
    "line_findings",
    "orality_findings",
    "unresolved_issues",
    "invalidated_artifacts"
  ],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "input_artifact_id": {"type": "string", "minLength": 1},
    "input_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "output_artifact_id": {"type": "string", "minLength": 1},
    "output_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "input_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "output_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "edit_type": {
      "type": "string",
      "minLength": 1
    },
    "changes_by_category": {
      "type": "object"
    },
    "continuity_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redundancy_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "line_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orality_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidated_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "no_change_justification": {
      "type": "string",
      "minLength": 1
    }
  }
}
