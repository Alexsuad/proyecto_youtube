{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/research_channel_context.json",
  "title": "ResearchChannelContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contract_version", "context_id", "episode_id", "profile_id", "profile_version", "profile_checksum", "editorial_identity", "editorial_purpose", "primary_promise", "audience_context", "territories", "research_relevant_limits", "origin_ref", "created_at"],
  "properties": {
    "contract": {"const": "research_channel_context"},
    "contract_version": {"const": "1.0.0"},
    "context_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "profile_checksum": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "editorial_identity": {"type": "string", "minLength": 1},
    "editorial_purpose": {"type": "string", "minLength": 1},
    "primary_promise": {"type": "string", "minLength": 1},
    "audience_context": {"type": "string", "minLength": 1},
    "territories": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "research_relevant_limits": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "origin_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
