{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/hardening_report_envelope.json",
  "title": "HardeningReportEnvelope",
  "type": "object",
  "required": ["schema_version", "plan_id", "mission_id", "repository_revision", "generated_at", "source_inputs", "evidence_refs", "limitations", "result"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "plan_id": {"const": "PLAN_004"},
    "mission_id": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "source_inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "string", "minLength": 1}
  }
}
