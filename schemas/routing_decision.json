{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/routing_decision.json",
  "title": "AuthorizedRoutingDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reasons", "candidate_set", "selected_profile", "external_cost_authorized"],
  "properties": {
    "status": {"type": "string", "enum": ["SELECTED", "RECOMMEND_ONLY", "BLOCKED"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "candidate_set": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "selected_profile": {"type": ["string", "null"], "minLength": 1},
    "external_cost_authorized": {"type": "boolean"}
  }
}
