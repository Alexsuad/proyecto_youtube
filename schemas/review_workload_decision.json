{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/review_workload_decision.json",
  "title": "ReviewWorkloadDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_level", "review_origin", "reasons", "evidence_refs"],
  "properties": {
    "review_level": {"type": "string", "enum": ["SELF_ONLY", "INDEPENDENT_REVIEW", "OWNER_REVIEW"]},
    "review_origin": {"type": "string", "enum": ["INTERNAL", "EXTERNAL", "NOT_APPLICABLE"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
