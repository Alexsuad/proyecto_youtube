            "prior_knowledge",
            "recognized_tension",
            "relevance",
            "expected_language_level",
            "likely_misinterpretation",
            "expectation_not_to_create"
          ],
          "properties": {
            "audience_segment": {
              "type": "string",
              "minLength": 1,
