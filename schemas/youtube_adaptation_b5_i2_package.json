              "minLength": 1
            },
            "relevance": {
              "type": "string",
              "minLength": 1
            },
            "expected_language_level": {
              "type": "string",
              "minLength": 1
            },
            "likely_misinterpretation": {
              "type": "string",
              "minLength": 1
            },
            "expectation_not_to_create": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "visible_promise": {
