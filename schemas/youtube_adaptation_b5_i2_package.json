            "uncertainties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "audiovisual_review_pending": {
              "type": "boolean"
            },
            "evidence_refs": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "rights_reuse_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quotes",
            "paraphrases",
            "dialogue_reproduction",
            "scene_dependency",
            "chronological_summary_dependency",
            "transformative_function",
            "commentary_and_analysis",
            "summary_substitution_risk",
            "textual_risk",
            "audiovisual_review_pending",
            "unresolved_items",
            "mitigations",
            "evidence_refs"
          ],
          "properties": {
            "quotes": {
