                "type": "string",
                "minLength": 1
              }
            },
            "supporting_claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unsupported_elements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "differentiation": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
