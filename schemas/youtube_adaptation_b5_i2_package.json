        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "input_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_brief", "refined_thesis", "editorial_script_promise", "evidence_or_claims_reference", "claims_ledger", "evidence_report"],
      "properties": {
        "episode_brief": {           "type": "object",           "additionalProperties": false,           "required": ["artifact_id", "version", "checksum"],           "properties": {             "artifact_id": {"type": "string", "minLength": 1},             "version": {"type": "string", "minLength": 1},             "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}           }         },
        "refined_thesis": {           "type": "object",           "additionalProperties": false,           "required": ["artifact_id", "version", "checksum"],           "properties": {             "artifact_id": {"type": "string", "minLength": 1},             "version": {"type": "string", "minLength": 1},             "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}           }         },
        "editorial_script_promise": {           "type": "object",           "additionalProperties": false,           "required": ["artifact_id", "version", "checksum"],           "properties": {             "artifact_id": {"type": "string", "minLength": 1},             "version": {"type": "string", "minLength": 1},             "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}           }         },
        "evidence_or_claims_reference": {           "type": "object",           "additionalProperties": false,           "required": ["artifact_id", "version", "checksum"],           "properties": {             "artifact_id": {"type": "string", "minLength": 1},             "version": {"type": "string", "minLength": 1},             "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}           }         },
        "claims_ledger": {           "type": "object",           "additionalProperties": false,           "required": ["artifact_id", "version", "checksum"],           "properties": {             "artifact_id": {"type": "string", "minLength": 1},             "version": {"type": "string", "minLength": 1},             "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}           }         },
        "evidence_report": {           "type": "object",           "additionalProperties": false,           "required": ["artifact_id", "version", "checksum"],           "properties": {             "artifact_id": {"type": "string", "minLength": 1},             "version": {"type": "string", "minLength": 1},             "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}           }         }
      }
    },
    "producer_run_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_youtube_positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concrete_audience",
        "visible_promise"
      ],
      "properties": {
        "concrete_audience": {
          "type": "object",
