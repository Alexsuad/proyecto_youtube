{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YouTubeAdaptationB5I2Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "episode_id",
    "active_profile_reference",
    "input_references",
    "producer_run_id",
