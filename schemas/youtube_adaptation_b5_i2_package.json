            "minimum_context": {
              "type": "string",
              "minLength": 1
            },
            "central_tension": {
              "type": "string",
              "minLength": 1
            },
            "viewer_relevance": {
              "type": "string",
              "minLength": 1
            },
            "route_preview": {
