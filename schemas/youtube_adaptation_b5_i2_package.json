              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "density_factors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "audience_factors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "compression_risk": {
              "type": "string",
              "minLength": 1
