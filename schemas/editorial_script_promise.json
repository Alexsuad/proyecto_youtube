{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EditorialScriptPromise",
  "type": "object",
  "additionalProperties": false,
  "required": ["promise_id", "episode_id", "refined_thesis_id", "refined_thesis_checksum", "audience", "editorial_promise", "central_tension", "legitimate_expectations", "expectations_to_avoid", "thesis_alignment", "textual_overpromise_risk", "opening_obligations", "inherited_constraint_ids", "status", "created_at"],
  "properties": {
    "promise_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "refined_thesis_id": {"type": "string", "minLength": 1},
    "refined_thesis_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "audience": {"type": "string", "minLength": 1},
    "editorial_promise": {"type": "string", "minLength": 1},
    "central_tension": {"type": "string", "minLength": 1},
    "legitimate_expectations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "expectations_to_avoid": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "thesis_alignment": {"type": "string", "minLength": 1},
    "textual_overpromise_risk": {"type": "object", "additionalProperties": false, "required": ["level", "justification", "mitigation_or_pending"], "properties": {"level": {"enum": ["LOW", "MEDIUM", "HIGH", "UNRESOLVED"]}, "justification": {"type": "string", "minLength": 1}, "mitigation_or_pending": {"type": ["string", "null"]}}},
    "opening_obligations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "inherited_constraint_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"const": "SCRIPT_CORE_INPUT"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
