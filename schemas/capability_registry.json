{
  "$schema":"http://json-schema.org/draft-07/schema#","title":"Capability Registry","type":"object","additionalProperties":false,
  "required":["registry_version","authority","routing_consumer","capabilities"],
  "properties":{"registry_version":{"type":"string"},"authority":{"const":"CAPABILITY_FUNCTIONAL_AUTHORITY"},"routing_consumer":{"const":"config/capability_routing.yaml"},"capabilities":{"type":"array","minItems":8,"items":{"$ref":"#/$defs/capability"}}},
  "$defs":{"capability":{"type":"object","additionalProperties":false,"required":["capability_id","domain","purpose","assigned_role","input_contract","output_contract","decision_authority","veto_authority","owner_escalation_conditions","maturity_status","availability_status","dependencies","prompt_reference","schema_reference"],"properties":{"capability_id":{"type":"string","pattern":"^[A-Z0-9_]+$"},"domain":{"const":"CHANNEL_INTELLIGENCE"},"purpose":{"type":"string","minLength":1},"assigned_role":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[A-Z0-9_]+$"}},"input_contract":{"type":"string"},"output_contract":{"type":"string"},"decision_authority":{"type":"string"},"veto_authority":{"type":"string"},"owner_escalation_conditions":{"type":"array","items":{"type":"string"}},"maturity_status":{"enum":["DEFINED","REGISTERED","IMPLEMENTED","DEMONSTRATED"]},"availability_status":{"enum":["NON_EXECUTABLE_CURRENT","READY_NOT_AUTHORIZED","ACTIVE","SUSPENDED","DEPRECATED"]},"dependencies":{"type":"array","items":{"type":"string"}},"prompt_reference":{"type":"array","items":{"type":"string"}},"schema_reference":{"type":"array","items":{"type":"string"}},"activation_rule":{"type":"string"}}}}
}