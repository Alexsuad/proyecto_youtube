{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://masalladelguion.com/schemas/mission_contract.json",
  "title": "MissionContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "artifact_id",
    "artifact_version",
    "authorized_paths",
    "protected_untracked_paths",
    "protected_untracked_baseline",
    "required_tests",
    "push_allowed",
    "state_requirements",
    "schema_checks"
  ],
  "properties": {
    "mission_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "authorized_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "protected_untracked_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "protected_untracked_baseline": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}}, "uniqueItems": true},
    "required_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "command"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    },
    "push_allowed": {"type": "boolean"},
    "push_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "ref", "baseline_remote_commit"],
      "properties": {
        "remote": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "baseline_remote_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"}
      }
    },
    "state_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_path", "required", "forbidden"],
      "properties": {
        "control_path": {"type": "string", "minLength": 1},
        "required": {"type": "object", "additionalProperties": {"type": "string"}},
        "forbidden": {"type": "object", "additionalProperties": {"type": ["string", "array"]}}
      }
    },
    "schema_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schema"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
