{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecutionProvenanceRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "runs"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/definitions/run"
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/handoff"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/attempt"
      }
    }
  },
  "definitions": {
