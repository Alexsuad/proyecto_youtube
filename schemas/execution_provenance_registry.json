        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_id": {
          "type": "string",
          "minLength": 1
        },
        "skill_version": {
          "type": "string",
          "minLength": 1
        },
        "skill_checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_manifest_checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "package_checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prepared_at": {
          "type": "string",
          "format": "date-time"
