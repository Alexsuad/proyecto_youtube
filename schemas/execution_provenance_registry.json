        "handoff_id",
        "capability_id",
        "episode_id",
        "skill_id",
        "skill_version",
        "skill_checksum",
        "input_manifest_checksum",
        "package_checksum",
        "prepared_at",
        "status",
        "run_id",
        "agent_id",
        "role_id",
        "provider",
        "model",
        "prompt_version",
        "input_artifact_ids",
        "input_versions",
        "input_checksums",
        "output_artifact_ids",
        "output_versions",
        "output_checksums",
        "started_at",
        "finished_at",
        "latency",
        "input_tokens",
        "output_tokens",
        "estimated_cost",
        "retry_count",
        "decision",
