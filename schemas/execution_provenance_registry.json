        "input_tokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "UNAVAILABLE_FROM_PROVIDER"
            }
          ]
        },
        "output_tokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "UNAVAILABLE_FROM_PROVIDER"
            }
          ]
        },
        "estimated_cost": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
